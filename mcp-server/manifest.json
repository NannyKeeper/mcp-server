{
  "manifest_version": "0.3",
  "name": "nannykeeper",
  "version": "1.7.0",
  "description": "Calculate US household employer (nanny) taxes for all 50 states. Preview and run payroll, generate W-2s and pay stubs, list state agency account numbers. 5 tools: calculate, threshold, preview, run, state-filing-status.",
  "author": {
    "name": "nannykeeper",
    "url": "https://github.com/nannykeeper"
  },
  "homepage": "https://www.nannykeeper.com/developers/mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/nannykeeper/mcp-server"
  },
  "license": "MIT",
  "privacy_policies": [
    "https://www.nannykeeper.com/privacy"
  ],
  "server": {
    "type": "node",
    "entry_point": "dist/index.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/dist/index.js"
      ],
      "env": {
        "NANNYKEEPER_API_KEY": ""
      }
    }
  }
}
